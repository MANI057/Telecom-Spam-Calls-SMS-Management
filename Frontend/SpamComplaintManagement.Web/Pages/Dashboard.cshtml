
@page
@model SpamComplaintManagement.Web.Pages.DashboardModel

<div class="dashboard-page">

    <div class="dashboard-header">
        <div>
            <h1>Spam Complaint Management</h1>
            <p>Welcome, @Model.UserName</p>
        </div>

        <div class="user-info">
            @Model.UserEmail
        </div>
    </div>

    <div class="dashboard-content">

        <div class="welcome-card">
            <div>
                <h2>Dashboard</h2>
                <p>Manage your spam complaints and track their status.</p>
            </div>
        </div>

        <div class="dashboard-grid">

            <a href="/Complaints/Create" class="dashboard-box report-box">
                <div class="icon">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M12 3L3 7V11C3 16.5 6.8 21.4 12 22C17.2 21.4 21 16.5 21 11V7L12 3Z"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linejoin="round"/>
                        <path d="M12 8V13"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"/>
                        <circle cx="12" cy="17" r="1"
                                fill="currentColor"/>
                    </svg>
                </div>

                <div class="box-content">
                    <h3>Report Spam</h3>
                    <p>Submit a new spam call, SMS, email, or other complaint.</p>
                </div>

                <span class="arrow">→</span>
            </a>

            <a href="/Complaints" class="dashboard-box">
                <div class="icon">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M4 5C4 3.9 4.9 3 6 3H18C19.1 3 20 3.9 20 5V19C20 20.1 19.1 21 18 21H6C4.9 21 4 20.1 4 19V5Z"
                              stroke="currentColor"
                              stroke-width="2"/>
                        <path d="M8 8H16"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"/>
                        <path d="M8 12H16"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"/>
                        <path d="M8 16H13"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"/>
                    </svg>
                </div>

                <div class="box-content">
                    <h3>My Complaints</h3>
                    <p>View all your submitted spam complaints.</p>
                </div>

                <span class="arrow">→</span>
            </a>

            <a href="/Complaints/Track" class="dashboard-box">
                <div class="icon">
                    <svg viewBox="0 0 24 24" fill="none">
                        <circle cx="11" cy="11" r="7"
                                stroke="currentColor"
                                stroke-width="2"/>
                        <path d="M16.5 16.5L21 21"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"/>
                    </svg>
                </div>

                <div class="box-content">
                    <h3>Track Complaint</h3>
                    <p>Track the status of a complaint using its Complaint ID.</p>
                </div>

                <span class="arrow">→</span>
            </a>

            <a href="/Account/Profile" class="dashboard-box">
                <div class="icon">
                    <svg viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="8" r="4"
                                stroke="currentColor"
                                stroke-width="2"/>
                        <path d="M4 21C4 16.6 7.6 14 12 14C16.4 14 20 16.6 20 21"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"/>
                    </svg>
                </div>

                <div class="box-content">
                    <h3>My Profile</h3>
                    <p>View your account information.</p>
                </div>

                <span class="arrow">→</span>
            </a>

        </div>

    </div>
</div>

<style>
    .dashboard-page {
        min-height: calc(100vh - 72px);
        background: #f6f8fb;
        padding: 35px 40px;
        box-sizing: border-box;
    }

    .dashboard-header {
        max-width: 1200px;
        margin: 0 auto 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .dashboard-header h1 {
        margin: 0 0 8px;
        color: #172033;
        font-size: 30px;
    }

    .dashboard-header p {
        margin: 0;
        color: #687386;
        font-size: 16px;
    }

    .user-info {
        background: white;
        padding: 12px 18px;
        border-radius: 10px;
        color: #687386;
        box-shadow: 0 3px 12px rgba(0,0,0,.05);
    }

    .dashboard-content {
        max-width: 1200px;
        margin: 0 auto;
    }

    .welcome-card {
        background: white;
        border-radius: 16px;
        padding: 25px 30px;
        margin-bottom: 25px;
        box-shadow: 0 5px 20px rgba(0,0,0,.06);
    }

    .welcome-card h2 {
        margin: 0 0 8px;
        color: #172033;
    }

    .welcome-card p {
        margin: 0;
        color: #687386;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .dashboard-box {
        position: relative;
        display: flex;
        align-items: center;
        gap: 18px;
        min-height: 145px;
        padding: 25px;
        background: white;
        border-radius: 16px;
        text-decoration: none;
        color: inherit;
        box-shadow: 0 5px 20px rgba(0,0,0,.06);
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .dashboard-box:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 28px rgba(0,0,0,.10);
    }

    .icon {
        width: 58px;
        height: 58px;
        min-width: 58px;
        border-radius: 14px;
        background: #eeeafe;
        color: #5b35d5;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon svg {
        width: 30px;
        height: 30px;
    }

    .box-content {
        padding-right: 30px;
    }

    .box-content h3 {
        margin: 0 0 8px;
        color: #172033;
        font-size: 20px;
    }

    .box-content p {
        margin: 0;
        color: #687386;
        line-height: 1.5;
    }

    .arrow {
        position: absolute;
        right: 22px;
        top: 50%;
        transform: translateY(-50%);
        color: #5b35d5;
        font-size: 24px;
        font-weight: 600;
    }

    .report-box {
        border: 2px solid #5b35d5;
    }

    .report-box .icon {
        background: #5b35d5;
        color: white;
    }

     @@media (max-width: 768px) {
        .dashboard-page {
            padding: 25px 18px;
        }

        .dashboard-header {
            display: block;
        }

        .user-info {
            display: inline-block;
            margin-top: 15px;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }
</style>